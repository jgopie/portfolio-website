---
import { getCollection } from 'astro:content';
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildCanonicalUrl, siteConfig } from "../data/site";

const blogPosts = await getCollection('blog');
const publishedPosts = blogPosts
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

const featuredNote = publishedPosts[0];
const featuredDate = featuredNote
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(featuredNote.data.publishedDate)
  : '';

const workLedger = [
  {
    title: "MLS Broker Portal",
    marker: "claim flow",
    role: "Full-stack build across React, Python, Firebase, Cloud Run, and async tasking.",
    note:
      "Designed listing detail surfaces and atomic claim-to-CRM behavior for work where duplicate ownership would have caused real operational pain.",
  },
  {
    title: "Permit & Property Verification Pipeline",
    marker: "automation",
    role: "Solo pipeline owner using Python, TypeScript, FastAPI, Playwright, PostgreSQL, and Docker.",
    note:
      "Turned brittle jurisdiction research into scheduled verification runs with integration coverage and fewer production surprises.",
  },
  {
    title: "WhatsApp AI Intake Automation",
    marker: "handoff",
    role: "Technical owner across Next.js, PostgreSQL, Prisma, WhatsApp Cloud API, OpenAI, and OAuth.",
    note:
      "Built structured triage, auditable summaries, human escalation, and case-management syncing for a conversational intake path.",
  },
];

const contactLinks = [
  { label: "Email", href: `mailto:${siteConfig.contactEmail}` },
  { label: "GitHub", href: siteConfig.githubUrl },
  { label: "LinkedIn", href: siteConfig.linkedinUrl },
];
---

<BaseLayout
  title="Home"
  description="Jordan Gopie's writing and software projects."
  canonicalUrl={buildCanonicalUrl('/')}
>
  <section class="desk-hero" aria-labelledby="home-title">
    <div class="desk-copy">
      <p class="hero-tagline">Software development</p>
      <h1 id="home-title">Jordan Gopie</h1>
      <p class="hero-statement">
        I build software in the part of the job where product ideas meet dates, client pressure,
        deployment constraints, and code that has to keep working after the demo.
      </p>
      <div class="hero-routes" aria-label="Primary routes">
        <a href="/blog" class="btn-primary">Read my writing</a>
        <a href="#work-ledger" class="btn-secondary">View my work</a>
      </div>
    </div>

    <aside class="featured-note" aria-label="Featured article">
      {featuredNote && (
        <a href={`/blog/${featuredNote.id}`} class="hero-slip">
          <span class="slip-label">Latest post</span>
          <time class="slip-date" datetime={featuredNote.data.publishedDate.toISOString()}>
            {featuredDate}
          </time>
          <strong>{featuredNote.data.title}</strong>
          <span class="slip-copy">{featuredNote.data.excerpt}</span>
        </a>
      )}
    </aside>
  </section>

  <section class="notes-section" aria-labelledby="notes-title">
    <div class="section-heading">
      <h2 id="notes-title">Writing</h2>
    </div>

    <div class="note-strip">
      {
        publishedPosts.slice(0, 3).map((post) => {
          const date = new Intl.DateTimeFormat('en-US', {
            month: 'short',
            year: 'numeric',
          }).format(post.data.publishedDate);

          return (
            <a href={`/blog/${post.id}`} class="note-strip-link">
              {post.data.image && <img src={`/${post.data.image}`} alt="" loading="lazy" />}
              <span>{date}</span>
              <strong>{post.data.title}</strong>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="now-section" aria-labelledby="now-title">
    <div class="section-heading">
      <h2 id="now-title">About this site</h2>
    </div>
    <div class="note-columns">
      <p>
        I write about projects, problems I've worked through, and what I've learned along the way.
      </p>
      <p>
        Older posts remain here as a record of how my work has developed.
      </p>
    </div>
  </section>

  <section class="work-section" id="work-ledger" aria-labelledby="work-title">
    <div class="section-heading">
      <h2 id="work-title">Selected work</h2>
    </div>

    <div class="ledger-list">
      {
        workLedger.map((entry, index) => (
          <article class="ledger-entry">
            <span class="ledger-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="ledger-marker">{entry.marker}</p>
              <h3>{entry.title}</h3>
            </div>
            <p class="ledger-role">{entry.role}</p>
            <p>{entry.note}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="section-heading">
      <h2 id="contact-title">Contact</h2>
      <p>
        Email is the best way to reach me. You can also find me on GitHub and LinkedIn.
      </p>
    </div>

    <div class="contact-grid">
      {
        contactLinks.map((link) => (
          <a
            href={link.href}
            class="contact-card"
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
          >
            <span>{link.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .now-section,
  .work-section,
  .notes-section,
  .contact-section {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .desk-hero {
    display: grid;
    padding-block: clamp(3rem, 5vw, 5rem);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    border-bottom: var(--rule);
  }

  .desk-copy {
    display: grid;
    min-width: 0;
    gap: var(--spacing-lg);
  }

  .desk-copy h1 {
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .hero-statement {
    max-width: 44rem;
    color: var(--text-primary);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.6;
  }

  .hero-routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .featured-note {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: var(--spacing-md);
  }

  .hero-slip {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding-block: 1.25rem;
    border-top: var(--rule);
    color: var(--text-secondary);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .hero-slip:is(:hover, :focus-visible) {
    border-color: var(--accent);
  }

  .slip-label,
  .slip-date {
    font-family: var(--font-sans);
    font-variation-settings: "MONO" 0, "CASL" 0;
    font-weight: 550;
    letter-spacing: 0;
    text-transform: none;
  }

  .slip-label {
    margin-bottom: 0.25rem;
    color: var(--annotation);
    font-size: 0.8125rem;
  }

  .slip-date {
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .hero-slip strong {
    max-width: 24ch;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .slip-copy {
    max-width: 34rem;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.6vw, 1.16rem);
    line-height: 1.55;
  }

  .ledger-marker,
  .note-strip-link span {
    color: var(--annotation);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-variation-settings: "MONO" 0, "CASL" 0;
    font-weight: 550;
    letter-spacing: 0;
    text-transform: none;
  }

  .section-heading {
    display: grid;
    gap: 0.8rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .section-heading h2 {
    max-width: 30ch;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.12;
    overflow-wrap: anywhere;
  }

  .section-heading p:not(.section-kicker) {
    font-size: 1.08rem;
  }

  .note-columns {
    display: grid;
    gap: var(--spacing-lg);
    max-width: 64rem;
  }

  .note-columns p {
    color: var(--text-primary);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.65;
  }

  .ledger-list {
    display: grid;
    border-top: var(--rule);
  }

  .ledger-entry {
    display: grid;
    gap: var(--spacing-md);
    padding: clamp(1.25rem, 3.5vw, 2.25rem) 0;
    border-bottom: var(--rule);
    overflow-wrap: anywhere;
  }

  .ledger-number {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-variation-settings: "MONO" 0, "CASL" 0;
  }

  .ledger-role {
    color: var(--text-primary);
  }

  .note-strip {
    display: grid;
    gap: var(--spacing-md);
  }

  .note-strip {
    gap: 0;
    border-top: var(--rule);
  }

  .note-strip-link {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 0.7rem 1rem;
    align-items: center;
    min-height: 112px;
    padding-block: 1.25rem;
    border-bottom: var(--rule);
    color: var(--text-primary);
    text-decoration: none;
  }

  .note-strip-link:is(:hover, :focus-visible) strong {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .note-strip-link img {
    grid-row: span 2;
    width: 96px;
    height: 96px;
    border-radius: calc(var(--radius-card) - 0.1rem);
    object-fit: cover;
  }

  .note-strip-link strong {
    align-self: start;
    font-size: 1.2rem;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .contact-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
  }

  .contact-card {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-weight: 550;
    text-decoration: underline;
  }

  .contact-card:is(:hover, :focus-visible) {
    text-decoration-thickness: 2px;
  }

  @media (min-width: 820px) {
    .desk-hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.75fr);
    }

    .note-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .note-strip-link {
      grid-template-columns: 96px 8rem minmax(0, 1fr);
      gap: 1.5rem;
    }

    .note-strip-link img {
      grid-row: auto;
    }

    .note-strip-link strong {
      align-self: center;
      font-size: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .ledger-entry {
      grid-template-columns: 4rem minmax(180px, 0.8fr) minmax(240px, 1fr) minmax(240px, 1.1fr);
      align-items: start;
    }
  }

  @media (max-width: 640px) {
    .note-strip-link {
      grid-template-columns: 76px minmax(0, 1fr);
      min-height: 96px;
    }

    .note-strip-link img {
      width: 76px;
      height: 76px;
    }
  }
</style>
