---
import { getCollection } from 'astro:content';
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/blog-card/BlogCard.astro";
import AppCard from "../components/projects/AppCard.astro";
import ClientProjectCard from "../components/projects/ClientProjectCard.astro";
import { apps, capabilities, clientProjects } from "../data/projects";
import { buildCanonicalUrl, siteConfig } from "../data/site";

const blogPosts = await getCollection('blog');
const publishedPosts = blogPosts
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

const [featuredApp, ...otherApps] = apps;

const contactLinks = [
  { label: "GitHub", href: siteConfig.githubUrl },
  { label: "LinkedIn", href: siteConfig.linkedinUrl },
];
---

<BaseLayout
  title="Mobile apps, backends & automations"
  description="Jordan Gopie builds mobile apps, backend systems, and automations that keep working after launch."
  canonicalUrl={buildCanonicalUrl('/')}
>
  <section class="hero" aria-labelledby="home-title">
    <p class="eyebrow">Jordan Gopie · Software developer</p>
    <h1 id="home-title">
      I build mobile apps, backends, and automations <span>that keep working after launch.</span>
    </h1>
    <p class="hero__lede">
      Through Viridian Software I take products from first build to production: shipped iOS apps,
      cloud backends for client platforms, and pipelines that replace hours of manual work.
    </p>
    <div class="hero__actions">
      <a href="#work" class="btn-primary">See my work</a>
      <a href="#contact" class="btn-secondary">Get in touch</a>
    </div>
  </section>

  <section class="section capabilities" aria-labelledby="capabilities-title">
    <h2 id="capabilities-title" class="visually-hidden">What I do</h2>
    <div class="capabilities__grid">
      {capabilities.map((item) => (
        <div class="capability">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <ul class="chips" aria-label={`${item.title} tools`}>
            {item.stack.map((tool) => <li class="chip">{tool}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="apps-title">
    <div class="section-head">
      <p class="eyebrow">Apps</p>
      <h2 id="apps-title">Things I've built and shipped</h2>
      <p>My own apps, from a live App Store game to volunteer and in-progress work.</p>
    </div>

    <AppCard app={featuredApp} featured />

    <div class="apps__grid">
      {otherApps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <section class="section" id="work-ledger" aria-labelledby="client-title">
    <div class="section-head-row">
      <div class="section-head">
        <p class="eyebrow">Client work</p>
        <h2 id="client-title">Production systems for clients</h2>
        <p>Selected engagements where reliability mattered as much as shipping.</p>
      </div>
      <a href="/work" class="text-link">All work <span aria-hidden="true">→</span></a>
    </div>

    <div class="client__grid">
      {clientProjects.map((project) => <ClientProjectCard project={project} />)}
    </div>
  </section>

  <section class="section" id="writing" aria-labelledby="writing-title">
    <div class="section-head-row">
      <div class="section-head">
        <p class="eyebrow">Writing</p>
        <h2 id="writing-title">Notes from building software</h2>
        <p>Project write-ups and lessons from client work, solo builds, and shipping.</p>
      </div>
      <a href="/blog" class="text-link">All posts <span aria-hidden="true">→</span></a>
    </div>

    <div class="writing__grid">
      {publishedPosts.slice(0, 3).map((post) => (
        <BlogCard
          title={post.data.title}
          excerpt={post.data.excerpt}
          image={post.data.image}
          publishedDate={post.data.publishedDate}
          slug={post.id}
          tags={post.data.tags}
          headingLevel="h3"
        />
      ))}
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="section-head">
      <p class="eyebrow">About</p>
      <h2 id="about-title">Hi, I'm Jordan.</h2>
    </div>
    <div class="about__body">
      <p>
        I'm a software developer who works across the whole stack, from mobile clients to the
        services and automations behind them. I started Viridian Software to take on client work,
        and I build my own apps alongside it.
      </p>
      <p>
        I care most about the part after the demo: deployments, data that stays consistent,
        edge cases that real users find, and code the next person can maintain. I'm comfortable
        owning a project solo or slotting into a team.
      </p>
    </div>
  </section>

  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="contact__panel">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">Have a project in mind?</h2>
        <p>
          Tell me what you're building or what's slowing your team down. Email is the best way to
          reach me.
        </p>
      </div>
      <div class="contact__actions">
        <a href={`mailto:${siteConfig.contactEmail}`} class="btn-primary">{siteConfig.contactEmail}</a>
        {contactLinks.map((link) => (
          <a href={link.href} class="btn-secondary" target="_blank" rel="noreferrer">
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    padding-block: clamp(3rem, 10vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }

  .hero h1 {
    max-width: 18ch;
    font-size: clamp(2.6rem, 6.4vw, 5rem);
    line-height: 1.02;
  }

  .hero h1 span {
    color: var(--text-secondary);
  }

  .hero__lede {
    max-width: 40rem;
    color: var(--text-secondary);
    font-size: clamp(1.08rem, 1.8vw, 1.3rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .capabilities {
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  .capabilities__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .capability {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .capability h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.2rem;
  }

  .capability h3::before {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 0.15rem;
    background: var(--accent);
    content: "";
  }

  .capability p {
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .apps__grid,
  .client__grid,
  .writing__grid {
    display: grid;
    gap: 1rem;
  }

  .apps__grid {
    margin-top: 1rem;
  }

  .about__body {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
  }

  .about__body p {
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: clamp(1.08rem, 1.7vw, 1.22rem);
    line-height: 1.7;
  }

  .contact__panel {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: var(--rule);
    border-radius: var(--radius-card);
    background:
      radial-gradient(ellipse 70% 90% at 0% 0%, var(--accent-muted), transparent 70%),
      var(--bg-surface);
  }

  .contact__panel .section-head {
    margin-bottom: 0;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .apps__grid,
    .client__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .capabilities__grid,
    .client__grid,
    .writing__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .apps__grid {
      margin-top: 1.25rem;
    }
  }
</style>
