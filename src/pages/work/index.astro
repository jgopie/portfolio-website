---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCard from '../../components/projects/AppCard.astro';
import ClientProjectCard from '../../components/projects/ClientProjectCard.astro';
import { apps, clientProjects } from '../../data/projects';
import { buildCanonicalUrl, siteConfig } from '../../data/site';

const [featuredApp, ...otherApps] = apps;
---
<BaseLayout
  title="Work"
  description="Mobile apps, backend systems, and automations built by Jordan Gopie."
  canonicalUrl={buildCanonicalUrl('/work')}
>
  <header class="page-head">
    <p class="eyebrow">Work</p>
    <h1>Apps, platforms, and automations</h1>
    <p>
      My own apps, followed by client systems I've built through Viridian Software. Client names
      are withheld; the details are real.
    </p>
  </header>

  <section class="work-group" aria-labelledby="apps-title">
    <h2 id="apps-title">Apps</h2>
    <AppCard app={featuredApp} featured headingLevel="h3" />
    <div class="work-grid">
      {otherApps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <section class="work-group" aria-labelledby="client-title">
    <h2 id="client-title">Client work</h2>
    <div class="work-grid">
      {clientProjects.map((project) => <ClientProjectCard project={project} />)}
    </div>
  </section>

  <section class="work-cta">
    <p>Need something similar built?</p>
    <a href={`mailto:${siteConfig.contactEmail}`} class="btn-primary">Email me</a>
  </section>
</BaseLayout>

<style>
  .work-group {
    display: grid;
    gap: 1rem;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .work-group h2 {
    margin-bottom: 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .work-grid {
    display: grid;
    gap: 1rem;
  }

  .work-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    border-top: var(--rule);
  }

  .work-cta p {
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    font-weight: 700;
  }

  @media (min-width: 720px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
