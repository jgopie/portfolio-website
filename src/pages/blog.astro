---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/blog-card/BlogCard.astro';
import { buildCanonicalUrl } from '../data/site';

const blogPosts = await getCollection('blog');
const publishedPosts = blogPosts
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
---
<BaseLayout
  title="Writing"
  description="Writing by Jordan Gopie about software development, automation, and lessons from building projects."
  canonicalUrl={buildCanonicalUrl('/blog')}
>
    <div class="notes-container">
        <header class="notes-header">
            <h1>Writing</h1>
            <p class="notes-subtitle">
                Posts about software development and what I've learned from building projects.
            </p>
        </header>

        <ul class="notes-list">
        {
            publishedPosts.map((post, index) => (
                <li>
                    <BlogCard
                      title={post.data.title}
                      excerpt={post.data.excerpt}
                      image={post.data.image}
                      publishedDate={post.data.publishedDate}
                      slug={post.id}
                      tags={post.data.tags}
                      index={index + 1}
                    />
                </li>
            ))
        }
        </ul>
    </div>
</BaseLayout>

<style>
    .notes-container {
        display: grid;
        gap: clamp(1rem, 2.5vw, 2rem);
        padding-block: clamp(1.5rem, 4vw, 3rem);
    }

    .notes-header {
        display: grid;
        gap: clamp(0.8rem, 2vw, var(--spacing-md));
        max-width: 68rem;
        padding-bottom: clamp(1.1rem, 3vw, 2rem);
        border-bottom: var(--rule);
    }

    .notes-header h1 {
        max-width: 24ch;
        font-size: clamp(2.25rem, 5vw, 4rem);
        line-height: 1.1;
        overflow-wrap: anywhere;
    }

    .notes-subtitle {
        color: var(--text-primary);
        max-width: 65ch;
        font-size: clamp(1.02rem, 1.55vw, 1.28rem);
        line-height: 1.55;
    }

    .notes-list {
        display: grid;
        gap: 0;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .notes-list li {
        list-style: none;
    }

</style>
