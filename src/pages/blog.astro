---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/blog-card/BlogCard.astro';
import { buildCanonicalUrl } from '../data/site';

const blogPosts = await getCollection('blog');
const publishedPosts = blogPosts
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
---
<BaseLayout
  title="Writing"
  description="Writing by Jordan Gopie about software development, automation, and lessons from building projects."
  canonicalUrl={buildCanonicalUrl('/blog')}
>
  <header class="page-head">
    <p class="eyebrow">Writing</p>
    <h1>Notes from building software</h1>
    <p>
      Project write-ups, post-mortems, and what I've learned from client work, solo builds, and
      getting things into production.
    </p>
  </header>

  <ul class="posts" role="list">
    {
      publishedPosts.map((post) => (
        <li>
          <BlogCard
            title={post.data.title}
            excerpt={post.data.excerpt}
            image={post.data.image}
            publishedDate={post.data.publishedDate}
            slug={post.id}
            tags={post.data.tags}
          />
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .posts {
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  .posts li {
    display: grid;
  }

  @media (min-width: 720px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
