---
import { siteConfig } from '../../data/site';

const year = new Date().getFullYear();
---
<footer class="footer">
    <div class="footer-copy">
        <p class="footer-name">Jordan Gopie</p>
        <p>Mobile apps, backend systems, and automations.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
        <a href="/work">Work</a>
        <a href="/blog">Writing</a>
        <a href={`mailto:${siteConfig.contactEmail}`}>Email</a>
        <a href={siteConfig.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={siteConfig.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>
    </nav>

    <p class="footer-fineprint">&copy; {year} Jordan Gopie · Viridian Software</p>
</footer>

<style>
.footer {
    display: grid;
    width: min(100% - 2rem, 1180px);
    gap: 1.25rem 2rem;
    margin: var(--spacing-xl) auto 0;
    padding: 2.5rem 0 3rem;
    border-top: var(--rule);
}

.footer-copy {
    display: grid;
    gap: 0.3rem;
}

.footer-name {
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-weight: 700;
}

.footer-copy p:not(.footer-name) {
    font-size: 0.92rem;
}

.footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
}

.footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 550;
    text-decoration: none;
}

.footer-links a:is(:hover, :focus-visible) {
    color: var(--accent);
}

.footer-fineprint {
    color: var(--text-faint);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
}

@media (min-width: 860px) {
    .footer {
        grid-template-columns: 1fr auto;
        align-items: center;
    }

    .footer-fineprint {
        grid-column: 1 / -1;
    }
}
</style>
