---
import { Image } from 'astro:assets';
import { getPostImage } from '../../data/postImages';

interface Props {
  title: string;
  excerpt: string;
  image: string | undefined;
  publishedDate: Date;
  slug: string;
  tags: string[];
  headingLevel?: 'h2' | 'h3';
}

const { title, excerpt, image, publishedDate, slug, tags, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const postImage = getPostImage(image);
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
}).format(publishedDate);
---
<article class="post-card">
  {postImage && (
    <Image
      class="post-card__image"
      src={postImage}
      alt=""
      width={720}
      widths={[360, 720]}
      sizes="(min-width: 960px) 22rem, 100vw"
      loading="lazy"
    />
  )}
  <div class="post-card__body">
    <p class="post-card__meta">
      <time datetime={publishedDate.toISOString()}>{formattedDate}</time>
      {tags[0] && <span aria-hidden="true">·</span>}
      {tags[0] && <span>{tags[0]}</span>}
    </p>
    <Heading class="post-card__title">
      <a href={`/blog/${slug}`}>{title}</a>
    </Heading>
    <p class="post-card__excerpt">{excerpt}</p>
  </div>
</article>

<style>
.post-card {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: var(--rule);
  border-radius: var(--radius-card);
  background: var(--bg-surface);
  transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.post-card:hover,
.post-card:focus-within {
  border-color: var(--border-strong);
}

.post-card__image {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-bottom: var(--rule);
}

.post-card__body {
  display: grid;
  gap: 0.6rem;
  padding: 1.25rem 1.35rem 1.5rem;
  overflow-wrap: anywhere;
}

.post-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  color: var(--text-faint);
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  font-weight: 550;
}

.post-card__title {
  font-size: 1.25rem;
  line-height: 1.25;
}

.post-card__title a {
  color: var(--text-primary);
  text-decoration: none;
}

/* Stretch the title link over the whole card. */
.post-card__title a::after {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  content: "";
}

.post-card:hover .post-card__title a {
  color: var(--accent);
}

.post-card__excerpt {
  font-size: 0.95rem;
  line-height: 1.6;
}
</style>
